# API Gateway của backend Moonkage (ví dụ: http://localhost:8080)
VITE_API_BASE_URL=http://localhost:8080

# Bật chế độ demo (dữ liệu mock trong bộ nhớ, không gọi backend)
VITE_DEMO_MODE=false

# WebSocket của backend (FR-27: realtime tiến độ đơn hàng)
VITE_WS_URL=

# ------------------------------------------------------------------
# Chế độ xác thực
# ------------------------------------------------------------------
# `bearer` (mặc định): token trong header `Authorization`, token nằm trong
#   token vault (memory + sessionStorage).
# `cookie`: backend quản lý cookie `HttpOnly; Secure; SameSite=Strict`.
#   Trình duyệt tự gửi cookie, không có token nào trong JS để bị đánh cắp.
#   Cần backend trả `Access-Control-Allow-Credentials: true`.
VITE_AUTH_MODE=bearer

# ------------------------------------------------------------------
# Feature flags — tắt/bật tính năng không cần deploy lại
# ------------------------------------------------------------------
# Tên biến = VITE_FEATURE_ + tên cờ ở dạng SCREAMING_SNAKE_CASE.
# Cờ mới mặc định tắt; cờ đã ổn định mặc định bật.
# Xem `src/shared/config/featureFlags.ts` để biết danh sách cờ.
VITE_FEATURE_NEW_CHECKOUT=false
VITE_FEATURE_VENDOR_ANALYTICS=false
VITE_FEATURE_OTP_VIA_ZNS=false
VITE_FEATURE_REALTIME_UPDATES=true
